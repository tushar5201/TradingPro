<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cradius"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Bottom sheet drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D1D5DB" />

    <!-- Header: Stock title and LTP -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTradeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="BUY RELIANCE"
                android:textColor="@color/primary_text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvTradeCompanyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_light"
                android:text="Reliance Industries Ltd • NSE"
                android:textColor="@color/desc_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTradeLtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="₹1,375.60"
                android:textColor="@color/primary_text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_light"
                android:text="Market Price"
                android:textColor="@color/desc_text"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Product Type Tabs (Delivery vs Intraday) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ed_style"
        android:orientation="horizontal"
        android:padding="3dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/tabDelivery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/cradius"
            android:backgroundTint="@color/yellow"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="Delivery"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabIntraday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="Intraday"
            android:textColor="@color/tabUnselect"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Quantity Stepper -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Quantity (Shares)"
        android:textColor="@color/primary_text"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/ed_style"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQtyMinus"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="-"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_bold" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:inputType="number"
            android:text="1"
            android:textColor="@color/primary_text"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQtyPlus"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_bold" />
    </LinearLayout>

    <!-- Quick Quantity Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipQty1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ed_style"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="+1"
            android:textColor="@color/primary_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipQty5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ed_style"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="+5"
            android:textColor="@color/primary_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipQty10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ed_style"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="+10"
            android:textColor="@color/primary_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipQty25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ed_style"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="+25"
            android:textColor="@color/primary_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipQtyAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ed_style"
            android:fontFamily="@font/poppins_medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="SELL ALL"
            android:textColor="#D53030"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Calculation & Wallet Balance Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/bg_color"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="Approx. Order Value"
                    android:textColor="@color/desc_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvApproxOrderValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/poppins_bold"
                    android:text="₹1,375.60"
                    android:textColor="@color/primary_text"
                    android:textSize="14sp" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvBalanceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="Available Balance"
                    android:textColor="@color/desc_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAvailableBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/poppins_medium"
                    android:text="₹100,000.00"
                    android:textColor="@color/green"
                    android:textSize="13sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvValidationError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins"
                android:text="Insufficient funds in your account"
                android:textColor="#D53030"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Large CTA Button (Buy or Sell) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmTrade"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="#00D09C"
        android:fontFamily="@font/poppins_bold"
        android:text="BUY RELIANCE"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

</LinearLayout>
